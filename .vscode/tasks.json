{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run FastAPI (run.bat)",
      "type": "shell",
      "command": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": {
          "regexp": ".*",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Uvicorn running.*",
          "endsPattern": ".*Application startup complete.*"
        }
      },
      "detail": "Jalan via python langsung (reliable, tidak butuh cmd). Untuk manual double-click, pakai run.bat di Explorer."
    }
  ]
}
